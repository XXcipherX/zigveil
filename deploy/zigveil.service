[Unit]
Description=Zigveil TLS ClientHello TCP passthrough proxy
After=network.target

[Service]
Type=simple
User=zigveil
Group=zigveil
ExecStart=/usr/local/bin/zigveil /etc/zigveil/config.json
Restart=on-failure
RestartSec=2s
KillSignal=SIGTERM
TimeoutStopSec=35s
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
